rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Student registry: public key + owner uid. Anyone signed in can look up a key,
    // but only the first claimant can create or change an ID.
    match /students/{sid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // Inbox: anyone signed in can drop an (encrypted) message in,
      // but only the student who owns this ID can read or delete messages.
      match /inbox/{mid} {
        allow create: if request.auth != null
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.box.size() < 900000;
        allow read, delete: if request.auth != null
                      && get(/databases/$(database)/documents/students/$(sid)).data.uid == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
